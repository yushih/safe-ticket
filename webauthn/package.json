{
  "name": "safe-tickets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "cf-typegen": "wrangler types",
    "check": "wrangler types && tsc --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.node.json",
    "build:client": "vite build",
    "build": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "cbor2": "^2.4.2",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
