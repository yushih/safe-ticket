{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safe-tickets",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "build": {
    "command": "npm run build:client"
  },
  "kv_namespaces": [{ "binding": "TICKETS" }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
